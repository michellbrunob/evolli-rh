# Copie para .env (raiz, ao lado deste arquivo) para uso pelo docker-compose.yml
# de desenvolvimento local. Nenhum valor aqui é segredo real; nao commitar .env.
#
# Usado somente para provisionar o container PostgreSQL local. As credenciais de
# aplicacao (evolli_app) e migration (evolli_migrator) sao criadas depois, via
# infra/postgres/ (ver infra/postgres/README.md), a partir deste usuario admin
# local do container.

POSTGRES_DB=evolli_rh_dev
POSTGRES_USER=postgres_local_admin
POSTGRES_PASSWORD=troque-por-uma-senha-local-qualquer
POSTGRES_PORT=5432
