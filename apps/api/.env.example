# Copie para .env e preencha com valores do seu ambiente local.
# Nenhum valor aqui é segredo real; nao commitar .env.
#
# IMPORTANTE (correção de segurança P1): este arquivo é o ambiente da API em
# runtime. MIGRATE_DATABASE_URL (credencial DDL do evolli_migrator) NUNCA deve
# entrar aqui, nem em nenhum outro arquivo/variavel usado para iniciar a API —
# ver apps/api/.env.migrate.example e infra/postgres/README.md.

NODE_ENV=development
PORT=3000

# Conexao de runtime da API — usuario evolli_app (somente DML, sem DDL).
# Aponta para o schema "app" (isolamento), nao para "public".
# Ver infra/postgres/README.md para criar o usuario e o schema.
DATABASE_URL=postgresql://evolli_app:troque-por-senha-local@localhost:5432/evolli_rh_dev?schema=app

# Versao da aplicacao exposta em /health. Preenchida em CI a partir da tag/commit.
APP_VERSION=0.0.0

# Nivel de log estruturado: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Timeout (ms) da checagem de prontidao do banco em GET /v1/health/ready.
DB_READY_TIMEOUT_MS=2000

# Chave de cifragem AES-256-GCM do segredo MFA (ADR 0003 §7). Obrigatoria,
# Base64 de exatamente 32 bytes, NUNCA versionada em ambiente real. Gere uma
# nova localmente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=troque-por-uma-chave-base64-de-32-bytes-gerada-localmente
