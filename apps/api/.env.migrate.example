# Copie para .env.migrate (mesma pasta) só na máquina/job que roda migration.
# Nenhum valor aqui é segredo real; nao commitar .env.migrate.
#
# Este arquivo NUNCA é lido pela API (ConfigModule.forRoot carrega só .env).
# É lido exclusivamente pelos scripts db:migrate:dev / db:migrate:deploy, via
# `node --env-file-if-exists=.env.migrate`, escopado ao subprocesso do Prisma
# CLI — nunca fica presente no processo da API. Se não existir, os scripts
# assumem que MIGRATE_DATABASE_URL já foi exportada no shell/pipeline (ex.:
# secret de CI), sem exigir este arquivo.

# Conexao exclusiva de migration — usuario evolli_migrator (DDL). Usada
# somente pelo Prisma CLI (prisma migrate dev/deploy).
MIGRATE_DATABASE_URL=postgresql://evolli_migrator:troque-por-senha-local@localhost:5432/evolli_rh_dev?schema=app
