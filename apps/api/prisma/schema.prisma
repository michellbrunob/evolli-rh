// Etapa 0 — Fatia 2/3: schema técnico. Nenhum modelo de domínio de RH
// (colaborador, folha, ponto, documento) é definido aqui — só identidade
// técnica de acesso (Fatia 3, ADR 0003).
//
// MFA (TOTP) foi adiado para a próxima fatia de segurança (decisão
// posterior aprovada) — nenhuma estrutura de MFA entra neste schema. Ver
// docs/modules/etapa0-fatia3-identidade-acesso.md e ADR 0003.
//
// `url` é a conexão de runtime da aplicação (usuário evolli_app, só DML).
// `directUrl` é usada exclusivamente pelo Prisma CLI para comandos de
// migration (usuário evolli_migrator, DDL) — nunca pela aplicação em
// runtime. Ver ADR 0002 (docs/adr/0002-papeis-postgres-e-migrations.md) e
// https://www.prisma.io/docs/postgres/database/connecting-to-your-database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

// Papel de acesso (RBAC). Ver docs/modules/etapa0-fatia3-identidade-acesso.md §3.
enum AccessRole {
  admin_tecnico
  rh
  dp
  gestor
  financeiro
  colaborador
  auditor
  dpo
}

enum AccessUserStatus {
  active
  disabled
  locked
}

// Usuário de acesso técnico — desacoplado de "colaborador" (Etapa 1),
// decisão fechada na ADR 0003 (§8). company_id/unit_id/team_id são
// referências técnicas sem FK enforced até a Etapa 1 existir de fato.
model AccessUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         AccessRole

  companyId String? @map("company_id")
  unitId    String? @map("unit_id")
  teamId    String? @map("team_id")

  status AccessUserStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions            AccessSession[]
  passwordResetTokens AccessPasswordResetToken[]
  auditEvents         AuditEvent[]

  // Etapa 1 — Fatia 2: quem registrou e quem efetivou uma movimentacao
  // funcional. Relacao de leitura apenas no schema Prisma — nenhuma coluna
  // nova entra em `access_user`; as FKs ficam em `movimentacao_funcional`.
  // NAO e o vinculo AccessUser <-> Colaborador (DP-23, deliberadamente nao
  // materializado): identifica o ATOR da operacao, nunca a pessoa registrada.
  movimentacoesSolicitadas MovimentacaoFuncional[] @relation("MovimentacaoSolicitante")
  movimentacoesExecutadas  MovimentacaoFuncional[] @relation("MovimentacaoExecutor")

  // Etapa 3 — quem registrou a marcacao/ajuste de ponto. Mesma natureza das
  // relacoes acima: identifica o ATOR da operacao, nunca a pessoa cujo ponto
  // foi registrado (essa e alcancada so via VinculoFuncional).
  pontosRegistrados       EventoPonto[] @relation("PontoRegistradoPor")
  ajustesPontoRegistrados AjustePonto[] @relation("AjustePontoRegistradoPor")

  // Etapa 2 — Documentos: quem solicitou um documento. Relacao de leitura
  // apenas — nenhuma coluna nova entra em `access_user`; a FK vive em
  // `solicitacao_documento`. Identifica o ATOR, nunca o sujeito do documento.
  solicitacoesDocumento SolicitacaoDocumento[] @relation("SolicitacaoDocumentoSolicitante")

  @@index([companyId])
  @@map("access_user")
}

// Sessão de servidor. `id` é só referência interna, NUNCA aceito como
// credencial — só `tokenHash` (derivado do token opaco do cookie) autentica
// (ADR 0003 §5). `csrfTokenHash` é o token synchronizer vinculado à sessão
// (ADR 0003 §6) — extensão técnica desta implementação, não altera o
// desenho aprovado.
model AccessSession {
  id            String @id @default(uuid())
  tokenHash     String @unique @map("token_hash")
  csrfTokenHash String @map("csrf_token_hash")
  userId        String @map("user_id")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")

  ip        String? @db.Inet
  userAgent String? @map("user_agent")

  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  user AccessUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("access_session")
}

model AccessPasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user AccessUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("access_password_reset_token")
}

// Suporte a rate limiting/lockout (§6).
model AccessLoginAttempt {
  id             String   @id @default(uuid())
  emailAttempted String   @map("email_attempted")
  ip             String?  @db.Inet
  succeeded      Boolean
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([emailAttempted, createdAt])
  @@map("access_login_attempt")
}

// Etapa 0 — Fatia 4: trilha de auditoria formal (ADR 0004). Distinta do log
// técnico de observabilidade (nestjs-pino, ADR 0001) — retenção, propósito e
// garantia de imutabilidade diferentes. Append-only: evolli_app tem só
// INSERT/SELECT nesta tabela (ver infra/postgres), nunca UPDATE/DELETE.
// Nenhum campo de conteúdo antes/depois (ADR 0004 §5) — só metadado seguro.
enum AuditActorType {
  user
  system
}

// Lista fechada de ações auditáveis (ADR 0004 §5, spec §4). Estender exige
// migration — nunca aceitar ação como texto livre.
//
// Os verbos da Etapa 0 (Fatias 3/4) permanecem em snake_case inglês, tal como
// mergeados — nada é renomeado (ADR 0006, Emenda 1, item 4). Os verbos do
// Núcleo Organizacional seguem a convenção aprovada em português separada por
// ponto (`organizacao.empresa.criada`), aplicada ao valor persistido via
// `@map`; o identificador Prisma usa `_` por ser restrição da linguagem, não
// escolha de nomenclatura. Convivência dos dois padrões é decisão explícita
// (ADR 0006, Emenda 1, item 5).
enum AuditAction {
  login_succeeded
  login_failed
  logout
  session_revoked
  session_expired
  password_reset_requested
  password_reset_completed
  user_created
  user_role_changed
  user_disabled
  authorization_denied
  rate_limit_blocked
  audit_log_read

  organizacao_empresa_criada     @map("organizacao.empresa.criada")
  organizacao_empresa_atualizada @map("organizacao.empresa.atualizada")
  organizacao_empresa_inativada  @map("organizacao.empresa.inativada")
  organizacao_empresa_reativada  @map("organizacao.empresa.reativada")

  organizacao_unidade_organizacional_criada     @map("organizacao.unidade_organizacional.criada")
  organizacao_unidade_organizacional_atualizada @map("organizacao.unidade_organizacional.atualizada")
  organizacao_unidade_organizacional_inativada  @map("organizacao.unidade_organizacional.inativada")
  organizacao_unidade_organizacional_reativada  @map("organizacao.unidade_organizacional.reativada")

  organizacao_departamento_criado     @map("organizacao.departamento.criado")
  organizacao_departamento_atualizado @map("organizacao.departamento.atualizado")
  organizacao_departamento_inativado  @map("organizacao.departamento.inativado")
  organizacao_departamento_reativado  @map("organizacao.departamento.reativado")

  organizacao_area_criada     @map("organizacao.area.criada")
  organizacao_area_atualizada @map("organizacao.area.atualizada")
  organizacao_area_inativada  @map("organizacao.area.inativada")
  organizacao_area_reativada  @map("organizacao.area.reativada")

  organizacao_equipe_criada     @map("organizacao.equipe.criada")
  organizacao_equipe_atualizada @map("organizacao.equipe.atualizada")
  organizacao_equipe_inativada  @map("organizacao.equipe.inativada")
  organizacao_equipe_reativada  @map("organizacao.equipe.reativada")

  organizacao_cargo_criado     @map("organizacao.cargo.criado")
  organizacao_cargo_atualizado @map("organizacao.cargo.atualizado")
  organizacao_cargo_inativado  @map("organizacao.cargo.inativado")
  organizacao_cargo_reativado  @map("organizacao.cargo.reativado")

  organizacao_centro_custo_criado     @map("organizacao.centro_custo.criado")
  organizacao_centro_custo_atualizado @map("organizacao.centro_custo.atualizado")
  organizacao_centro_custo_inativado  @map("organizacao.centro_custo.inativado")
  organizacao_centro_custo_reativado  @map("organizacao.centro_custo.reativado")

  organizacao_estrutura_consultada @map("organizacao.estrutura.consultada")

  // Etapa 1 — Fatia 2: Colaboradores e vida funcional (ADR 0007, Baseline V1).
  // Mesma convencao da Fatia 1 — valor persistido em portugues separado por
  // ponto, identificador Prisma com `_`. Terceira familia de nomenclatura de
  // evento convivendo por decisao explicita (ADR 0006 Emenda 1 item 5,
  // reafirmada pela ADR 0007).
  //
  // Verbos deliberadamente AUSENTES, por a capacidade correspondente nao
  // existir nesta V1 (nao ha o que auditar):
  //   - aprovada/rejeitada  -> sem workflow de aprovacao (Baseline V1, item 7)
  //   - dado_restrito.*     -> dado restrito fora da fatia (item 5)
  //   - colaborador.consultado -> nenhum papel tem escopo amplo neste dominio,
  //     entao "leitura fora do escopo proprio" e sempre 404, nunca leitura
  pessoas_colaborador_criado     @map("pessoas.colaborador.criado")
  pessoas_colaborador_atualizado @map("pessoas.colaborador.atualizado")

  pessoas_vinculo_criado    @map("pessoas.vinculo.criado")
  pessoas_vinculo_ativado   @map("pessoas.vinculo.ativado")
  pessoas_vinculo_encerrado @map("pessoas.vinculo.encerrado")

  pessoas_movimentacao_registrada @map("pessoas.movimentacao.registrada")
  pessoas_movimentacao_programada @map("pessoas.movimentacao.programada")
  pessoas_movimentacao_efetivada  @map("pessoas.movimentacao.efetivada")
  pessoas_movimentacao_cancelada  @map("pessoas.movimentacao.cancelada")
  pessoas_movimentacao_retificada @map("pessoas.movimentacao.retificada")

  pessoas_alocacao_criada    @map("pessoas.alocacao.criada")
  pessoas_alocacao_encerrada @map("pessoas.alocacao.encerrada")

  // Etapa 3 — Jornada e Ponto Rastreavel (ADR 0008, Baseline Jornada V1).
  // Mesma convencao: valor persistido em portugues separado por ponto,
  // identificador Prisma com `_`.
  //
  // Verbos deliberadamente AUSENTES, por a capacidade nao existir nesta V1:
  //   - ponto.evento.alterado / .excluido -> o evento e IMUTAVEL; nao ha
  //     caminho de alteracao a auditar (Baseline Jornada V1, decisao 4). A
  //     correcao aparece como `ponto.ajuste.registrado`, nunca como alteracao.
  //   - ponto.periodo.fechado / .aprovado -> fechamento e aprovacao estao fora
  //     desta V1 (decisao 7).
  //
  // `ponto.consultado` EXISTE aqui, diferente de `pessoas.*` (onde leitura no
  // proprio escopo nao gera evento): a spec da Etapa 3, §5.5, argumenta que
  // ver dado de jornada/presenca de terceiro e, em si, acao sensivel — mesmo
  // criterio que ja faz `audit_log_read` auditar toda leitura da trilha
  // (ADR 0004, decisao 6). Consequencia de volume registrada na spec.
  ponto_evento_registrado @map("ponto.evento.registrado")
  ponto_ajuste_registrado @map("ponto.ajuste.registrado")
  ponto_consultado        @map("ponto.consultado")

  // Etapa 2 — Documentos (metadados, sem conteudo; ADR 0011, T008). Mesma
  // convencao: valor persistido em portugues separado por ponto, identificador
  // Prisma com `_`. A trilha registra a ACAO e o identificador tecnico do
  // recurso — NUNCA o rotulo/tipo documental (ADR 0011, decisao 10; DP-2E-12),
  // que revelaria categoria sensivel por inferencia.
  //
  // Verbos deliberadamente AUSENTES por a capacidade nao existir nesta V1 (sem
  // conteudo): versao_recebida/aprovada/reprovada, conteudo_baixado, expirado.
  documentos_tipo_documento_criado          @map("documentos.tipo_documento.criado")
  documentos_tipo_documento_atualizado      @map("documentos.tipo_documento.atualizado")
  documentos_documento_metadado_criado      @map("documentos.documento_metadado.criado")
  documentos_documento_metadado_consultado  @map("documentos.documento_metadado.consultado")
  documentos_documento_metadado_substituido @map("documentos.documento_metadado.substituido")
  documentos_solicitacao_documento_criada   @map("documentos.solicitacao_documento.criada")
}

enum AuditResult {
  success
  failure
  denied
}

model AuditEvent {
  id String @id @default(uuid())

  occurredAt DateTime @map("occurred_at")

  // Ator: "user" referencia AccessUser (actorUserId); "system" identifica a
  // origem técnica (actorSystemId, ex. "auth-service:login") quando não há
  // usuário autenticado resolvido — nunca um ator nulo sem identificação.
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id")
  actorSystemId String?        @map("actor_system_id")
  // Snapshot do papel do ator no momento da ação — papel pode mudar depois;
  // o evento preserva o papel vigente na hora (null quando actorType=system).
  actorRole     AccessRole?    @map("actor_role")

  companyId String? @map("company_id")
  unitId    String? @map("unit_id")
  teamId    String? @map("team_id")

  action AuditAction

  // Tipo do recurso é validado por união de tipos no código (extensível por
  // módulo futuro sem migration) — não é enum de banco, ao contrário de
  // `action`/`result`, que são fechados por design (ADR 0004 §5).
  resource   String
  resourceId String? @map("resource_id")

  // Minimizados (ADR 0004 §5) — mesmo par já usado em SessionRequestMetadata
  // (Fatia 3), sem cabeçalho ou fingerprint adicional.
  ip        String? @db.Inet
  userAgent String? @map("user_agent")

  result AuditResult

  requestId     String  @map("request_id")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  actorUser AccessUser? @relation(fields: [actorUserId], references: [id])

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([companyId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Etapa 1 — Fatia 1: Núcleo Organizacional Interno
// ---------------------------------------------------------------------------
// Modelo aprovado na Baseline V1 (ADR 0006) e especificado em
// docs/modules/etapa1-nucleo-organizacional.md §3. Nomenclatura em português
// (ADR 0006, Emenda 1): tipos PascalCase, campos camelCase, tabelas e colunas
// snake_case — todos sem acento.
//
// Limites estruturais desta fatia, por decisão explícita:
//   - Departamento e Area são estrutura, NÃO fronteira de autorização
//     (Baseline V1 item 2): nenhum `departamento_id`/`area_id` é adicionado a
//     `access_user` nem a `audit_event`; `empresa_id` continua o maior limite.
//   - Sem hierarquia recursiva e sem relação de gestor/subordinado, nem
//     estruturalmente (item 8).
//   - Sem campo de vigência nos nós organizacionais (item 9).
//   - Sem CNPJ (DP-4, pendente), sem colaborador, vínculo, função, salário,
//     folha, ponto, documento, benefício ou qualquer dado pessoal.
//   - Sem exclusão física: "remover" é sempre transição de `status` (R6).

enum StatusOrganizacional {
  ativo
  inativo
}

model Empresa {
  id     String               @id @default(uuid())
  codigo String               @unique
  nome   String
  status StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  unidades      UnidadeOrganizacional[]
  departamentos Departamento[]
  equipes       Equipe[]
  cargos        Cargo[]
  centrosCusto  CentroCusto[]

  // Etapa 1 — Fatia 2
  vinculos      VinculoFuncional[]
  alocacoes     AlocacaoOrganizacional[]
  movimentacoes MovimentacaoFuncional[]

  // Etapa 3 — Jornada e Ponto. `empresa_id` redundante com o do vinculo por
  // desenho: e o que permite a FK COMPOSTA garantir, no banco, que evento e
  // ajuste nunca cruzam empresa (mesmo padrao de alocacao/movimentacao).
  eventosPonto EventoPonto[]
  ajustesPonto AjustePonto[]

  // Etapa 2 — Documentos (metadados, sem conteudo). `empresa_id` continua a
  // unica fronteira de autorizacao (ADR 0011, decisao 5).
  tiposDocumento        TipoDocumento[]
  documentosMetadado    DocumentoMetadado[]
  solicitacoesDocumento SolicitacaoDocumento[]

  @@index([status])
  @@map("empresa")
}

model UnidadeOrganizacional {
  id        String               @id @default(uuid())
  empresaId String               @map("empresa_id")
  codigo    String
  nome      String
  status    StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipes Equipe[]

  // Etapa 1 — Fatia 2
  alocacoes         AlocacaoOrganizacional[]
  movimentacoesAlvo MovimentacaoFuncional[]

  @@unique([empresaId, codigo])
  // Alvo da FK composta vinda de Equipe: o banco passa a garantir que a
  // unidade referenciada pertence à mesma empresa da equipe (spec R5), sem
  // depender de validação de aplicação. A Fatia 2 reaproveita o mesmo alvo
  // para alocacao_organizacional e movimentacao_funcional.
  @@unique([id, empresaId])
  @@index([empresaId, status])
  @@map("unidade_organizacional")
}

model Departamento {
  id        String               @id @default(uuid())
  empresaId String               @map("empresa_id")
  codigo    String
  nome      String
  status    StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  areas   Area[]
  equipes Equipe[]

  // Etapa 1 — Fatia 2
  alocacoes         AlocacaoOrganizacional[]
  movimentacoesAlvo MovimentacaoFuncional[]

  @@unique([empresaId, codigo])
  // Mesmo propósito do par em UnidadeOrganizacional: alvo da FK composta de
  // Equipe, garantindo mesma empresa no nível do banco (spec R5). A Fatia 2
  // reaproveita o mesmo alvo para alocacao e movimentacao.
  @@unique([id, empresaId])
  @@index([empresaId, status])
  @@map("departamento")
}

// Subdivisão OPCIONAL de Departamento (Baseline V1 item 1). Não tem
// `empresa_id` próprio de propósito: a empresa é sempre a do departamento
// pai, o que torna divergência de empresa impossível por construção — não há
// o que validar nem o que denormalizar.
model Area {
  id             String               @id @default(uuid())
  departamentoId String               @map("departamento_id")
  codigo         String
  nome           String
  status         StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Etapa 1 — Fatia 2
  alocacoes         AlocacaoOrganizacional[]
  movimentacoesAlvo MovimentacaoFuncional[]

  @@unique([departamentoId, codigo])
  // Alvo da FK composta (area_id, departamento_id) vinda da Fatia 2. Como
  // `departamento` ja carrega FK composta com `empresa_id`, a cadeia
  // area -> departamento -> empresa fica garantida pelo banco, mesmo sem
  // `empresa_id` proprio nesta tabela.
  @@unique([id, departamentoId])
  @@index([departamentoId, status])
  @@map("area")
}

// Pertence obrigatoriamente a um Departamento e, opcionalmente, a uma
// UnidadeOrganizacional (Baseline V1 item 3). As duas referências são FKs
// COMPOSTAS incluindo `empresa_id`, de modo que o banco recusa equipe cujo
// departamento ou unidade sejam de outra empresa (spec R5).
model Equipe {
  id                      String               @id @default(uuid())
  empresaId               String               @map("empresa_id")
  departamentoId          String               @map("departamento_id")
  unidadeOrganizacionalId String?              @map("unidade_organizacional_id")
  codigo                  String
  nome                    String
  status                  StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa               Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  departamento          Departamento           @relation(fields: [departamentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  unidadeOrganizacional UnidadeOrganizacional? @relation(fields: [unidadeOrganizacionalId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)

  // Etapa 1 — Fatia 2
  alocacoes         AlocacaoOrganizacional[]
  movimentacoesAlvo MovimentacaoFuncional[]

  @@unique([departamentoId, codigo])
  /// Alvo da FK composta da Fatia 2 (equipe_id, empresa_id).
  @@unique([id, empresaId])
  @@index([empresaId, status])
  @@index([departamentoId])
  @@index([unidadeOrganizacionalId])
  @@map("equipe")
}

// Catálogo de cargos POR EMPRESA (Baseline V1 item 5). "Cargo", nunca "Role":
// o domínio de autorização já usa papel (`AccessRole`) para outro conceito
// (ADR 0006, Emenda 1, item 3). Sem faixa salarial, CBO, jornada ou qualquer
// atributo trabalhista/fiscal — e sem "função", que fica para a vida
// funcional futura do colaborador (item 4).
model Cargo {
  id        String               @id @default(uuid())
  empresaId String               @map("empresa_id")
  codigo    String
  nome      String
  status    StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Etapa 1 — Fatia 2
  alocacoes         AlocacaoOrganizacional[]
  movimentacoesAlvo MovimentacaoFuncional[]

  @@unique([empresaId, codigo])
  /// Alvo da FK composta da Fatia 2 (cargo_id, empresa_id).
  @@unique([id, empresaId])
  @@index([empresaId, status])
  @@map("cargo")
}

// Cadastro por empresa, SEM associação a unidade, departamento, área ou
// equipe nesta fatia (Baseline V1 item 6). Rótulo organizacional apenas: sem
// valor monetário, rateio, plano de contas ou integração financeira.
model CentroCusto {
  id        String               @id @default(uuid())
  empresaId String               @map("empresa_id")
  codigo    String
  nome      String
  status    StatusOrganizacional @default(ativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Etapa 1 — Fatia 2
  alocacoes         AlocacaoOrganizacional[]
  movimentacoesAlvo MovimentacaoFuncional[]

  @@unique([empresaId, codigo])
  /// Alvo da FK composta da Fatia 2 (centro_custo_id, empresa_id).
  @@unique([id, empresaId])
  @@index([empresaId, status])
  @@map("centro_custo")
}

// ---------------------------------------------------------------------------
// Etapa 1 — Fatia 2: Colaboradores e Vida Funcional
// ---------------------------------------------------------------------------
// Modelo aprovado na Baseline V1 (ADR 0007) e especificado em
// docs/modules/etapa1-fatia2-colaboradores-vida-funcional.md.
//
// DADOS APROVADOS, lista fechada (Baseline V1, item 1): nome completo,
// matricula (no vinculo), situacao, tipo/situacao do vinculo, referencias
// organizacionais aprovadas e datas funcionais. NENHUM outro dado pessoal.
//
// AUSENCIAS DELIBERADAS — cada uma por decisao registrada, nao por esquecimento:
//   - CPF, RG, endereco, telefone, e-mail, data de nascimento, nome social,
//     identidade de genero: fora desta fatia (Baseline V1, itens 1 e 9).
//   - salario, remuneracao, beneficio, dado familiar, medico ou sensivel:
//     fora desta fatia (item 5).
//   - documento, anexo, imagem ou arquivo: dependem do modulo de Documentos,
//     Etapa 2 (DP-24).
//   - ferias, afastamento, retorno e jornada: dependem de Ponto (Etapa 3) e de
//     regra trabalhista nao decidida — ausentes dos enums de tipo/situacao.
//   - gestor/subordinado: nao antecipado, nem estruturalmente (ADR 0006, d. 8).
//   - vinculo AccessUser <-> Colaborador: nao materializado (DP-23). Os campos
//     solicitante_user_id/executor_user_id identificam o ATOR da operacao,
//     nunca a pessoa registrada.
//   - workflow de aprovacao: sem tabela, sem estado aprovada/rejeitada (item 7).
//   - tenant_id, RLS multitenant: fora de escopo (ADR 0005, d. 2).
//   - exclusao fisica: nenhuma rota DELETE; onDelete Restrict em toda FK.

enum SituacaoColaborador {
  ativo
  inativo
}

/// Catalogo FECHADO (Baseline V1, item 4). `outro_controlado` e valor de
/// escape do proprio enum — nunca texto livre. Nenhum tipo altera
/// comportamento do sistema: sem calculo, sem enquadramento legal, sem
/// automacao trabalhista.
enum TipoVinculo {
  clt
  estagio
  pj
  temporario
  outro_controlado
}

/// Sem `suspenso`: afastamento esta fora desta fatia. Reintroduzir e migration
/// aditiva quando a capacidade for aprovada — valor de enum morto seria mais
/// caro de remover depois do que de acrescentar na hora certa.
enum SituacaoVinculo {
  previsto
  ativo
  encerrado
}

/// Sem `ferias`, `afastamento`, `retorno` e `alteracao_jornada`: dependem de
/// regra trabalhista e do modulo de Ponto, ambos fora desta fatia.
enum TipoMovimentacao {
  admissao
  transferencia_organizacional
  mudanca_cargo
  desligamento
}

/// Sem `aprovada`/`rejeitada`: nao ha workflow de aprovacao nesta V1
/// (Baseline V1, item 7). RH/DP registram e efetivam diretamente, sob
/// responsabilidade auditada.
enum StatusMovimentacao {
  solicitada
  programada
  efetivada
  cancelada
  retificada
}

/// Catalogo controlado de motivos (Baseline V1, item 11) — substitui texto
/// livre justamente para que dado sensivel (ex.: diagnostico medico) nao possa
/// ser digitado num campo de observacao nao classificado.
///
/// Rotulos deliberadamente ORGANIZACIONAIS, nunca classificacao juridica: nao
/// ha "justa causa", "pedido de demissao" ou equivalente, porque isso seria
/// enquadramento trabalhista, que esta fatia nao decide nem registra. O
/// conteudo definitivo por tipo de movimentacao segue pendente de validacao
/// com RH — extensivel de forma aditiva, sem bloquear esta entrega.
enum MotivoMovimentacao {
  admissao_inicial
  reestruturacao_organizacional
  realocacao_interna
  promocao
  correcao_cadastral
  encerramento_de_vinculo
  outro_controlado
}

/// A pessoa. NAO tem `empresa_id`: a empresa e propriedade do VINCULO, nunca
/// do colaborador (Baseline V1, item 2) — a mesma pessoa pode ter vinculos
/// historicos em empresas diferentes.
///
/// Consequencia de autorizacao: o escopo de leitura de um colaborador e
/// derivado dos seus vinculos, nunca de um campo proprio. Por isso todo
/// colaborador nasce junto do seu primeiro vinculo — um cadastro sem vinculo
/// ficaria fora de qualquer escopo e invisivel a todos.
model Colaborador {
  id   String @id @default(uuid())
  nome String

  /// Derivada dos vinculos e materializada na mesma transacao que os altera —
  /// nunca alterada por comando direto (spec §8).
  situacao SituacaoColaborador @default(inativo)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vinculos VinculoFuncional[]

  // Etapa 2 — Documentos: o colaborador e o SUJEITO do documento (ADR 0011,
  // DP-2E-07). Relacao de leitura apenas; a coerencia empresa<->colaborador e
  // validada na aplicacao (o colaborador precisa ter vinculo na empresa do
  // documento), ja que o colaborador nao carrega `empresa_id` proprio.
  documentosMetadado    DocumentoMetadado[]
  solicitacoesDocumento SolicitacaoDocumento[]

  @@index([situacao])
  @@map("colaborador")
}

/// A relacao formal entre um Colaborador e uma Empresa. E ele — nao o
/// colaborador — que carrega `empresa_id`, e portanto a fronteira de
/// autorizacao (ADR 0005, d. 3; ADR 0007, d. 11).
///
/// Garantias de banco desta tabela:
///   - matricula unica DENTRO da empresa (Baseline V1, item 2);
///   - no maximo UM vinculo `ativo` por (colaborador, empresa) — indice unico
///     PARCIAL criado na migration, ja que Prisma nao expressa WHERE em indice
///     (RI-V6, Baseline V1 item 3);
///   - data_desligamento >= data_admissao (CHECK na migration, RI-V4).
model VinculoFuncional {
  id            String          @id @default(uuid())
  colaboradorId String          @map("colaborador_id")
  empresaId     String          @map("empresa_id")
  matricula     String
  tipo          TipoVinculo
  situacao      SituacaoVinculo @default(previsto)

  dataAdmissao     DateTime  @map("data_admissao") @db.Date
  dataDesligamento DateTime? @map("data_desligamento") @db.Date

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  alocacoes     AlocacaoOrganizacional[]
  movimentacoes MovimentacaoFuncional[]
  eventosPonto  EventoPonto[]

  @@unique([empresaId, matricula])
  /// Alvo das FKs compostas de alocacao e movimentacao: o banco garante que
  /// filho e vinculo pertencem a mesma empresa, sem depender da aplicacao.
  @@unique([id, empresaId])
  @@index([colaboradorId])
  @@index([empresaId, situacao])
  @@map("vinculo_funcional")
}

/// O ESTADO: onde o vinculo esta posicionado na estrutura organizacional, e
/// durante qual periodo. Sucessao, nunca sobrescrita (ADR 0007, d. 6).
///
/// TODA referencia organizacional e FK COMPOSTA com empresa_id (ou, no caso de
/// `area`, com departamento_id, que por sua vez e composto com empresa): o
/// PostgreSQL recusa alocacao apontando para no de outra empresa mesmo que a
/// validacao de aplicacao falhe (RI-A1).
///
/// Garantias adicionais criadas na migration (Prisma nao as expressa):
///   - NAO SOBREPOSICAO de periodos do mesmo vinculo, por EXCLUSION CONSTRAINT
///     GiST sobre daterange(vigente_de, vigente_ate, '[)') — inicio inclusivo,
///     fim exclusivo, e `vigente_ate` nulo como limite INFINITO. Exige a
///     extensao btree_gist, provisionada pelo admin/owner via
///     infra/postgres/04_extensions.sql (pre-condicao verificada pela propria
///     migration, que aborta se faltar). Prisma nao tem sintaxe para EXCLUDE:
///     a constraint vive em SQL explicito na migration, e este comentario e a
///     documentacao dela — nenhuma estrutura Prisma falsa e declarada;
///   - no maximo UMA alocacao aberta (vigente_ate IS NULL) por vinculo
///     (complemento com erro de unicidade estavel, nao substituto do EXCLUDE);
///   - vigente_ate > vigente_de;
///   - area_id so com departamento_id preenchido (senao a FK composta nao
///     seria verificada, por MATCH SIMPLE);
///   - ao menos uma referencia organizacional preenchida.
model AlocacaoOrganizacional {
  id        String @id @default(uuid())
  vinculoId String @map("vinculo_id")

  /// Redundante por desenho, exatamente como em `equipe`: e o que viabiliza as
  /// FKs compostas abaixo.
  empresaId String @map("empresa_id")

  unidadeOrganizacionalId String? @map("unidade_organizacional_id")
  departamentoId          String? @map("departamento_id")
  areaId                  String? @map("area_id")
  equipeId                String? @map("equipe_id")
  cargoId                 String? @map("cargo_id")
  centroCustoId           String? @map("centro_custo_id")

  vigenteDe DateTime @map("vigente_de") @db.Date

  /// `null` = alocacao vigente. Fechar este campo e a UNICA alteracao admitida
  /// numa alocacao (RI-A5).
  vigenteAte DateTime? @map("vigente_ate") @db.Date

  /// Todo estado tem o ato que o produziu (RI-A4). Nao existe alocacao sem
  /// movimentacao de origem.
  movimentacaoOrigemId String @map("movimentacao_origem_id")

  criadoEm DateTime @default(now()) @map("criado_em")

  vinculo               VinculoFuncional       @relation(fields: [vinculoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  empresa               Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unidadeOrganizacional UnidadeOrganizacional? @relation(fields: [unidadeOrganizacionalId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  departamento          Departamento?          @relation(fields: [departamentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  area                  Area?                  @relation(fields: [areaId, departamentoId], references: [id, departamentoId], onDelete: Restrict, onUpdate: Cascade)
  equipe                Equipe?                @relation(fields: [equipeId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  cargo                 Cargo?                 @relation(fields: [cargoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  centroCusto           CentroCusto?           @relation(fields: [centroCustoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  movimentacaoOrigem    MovimentacaoFuncional  @relation(fields: [movimentacaoOrigemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Duas alocacoes do mesmo vinculo nunca comecam na mesma data.
  @@unique([vinculoId, vigenteDe])
  @@index([vinculoId, vigenteDe])
  @@index([empresaId])
  @@index([unidadeOrganizacionalId])
  @@index([departamentoId])
  @@index([areaId])
  @@index([equipeId])
  @@index([cargoId])
  @@index([centroCustoId])
  @@index([movimentacaoOrigemId])
  @@map("alocacao_organizacional")
}

/// O ATO: o evento que altera a vida funcional. Imutavel depois de efetivada;
/// correcao e retificacao — movimentacao nova que referencia a original, que
/// permanece visivel (ADR 0007, d. 7).
///
/// Os campos destino_* sao a instrucao ("mover para o departamento X, cargo Y,
/// a partir de D"); a efetivacao os materializa em alocacao_organizacional.
/// Guardar o destino no ato — e nao so na alocacao — e o que da sentido a uma
/// movimentacao `programada`, que ainda nao produziu estado nenhum.
///
/// SEM campo de motivo em texto livre (Baseline V1, item 11) e SEM tabela de
/// aprovacao (item 7).
model MovimentacaoFuncional {
  id        String             @id @default(uuid())
  vinculoId String             @map("vinculo_id")
  empresaId String             @map("empresa_id")
  tipo      TipoMovimentacao
  status    StatusMovimentacao @default(solicitada)

  motivoCodigo MotivoMovimentacao @map("motivo_codigo")

  registradaEm DateTime @default(now()) @map("registrada_em")

  /// Ator que registrou — `AccessUser`, nunca o colaborador registrado.
  solicitanteUserId String @map("solicitante_user_id")

  vigenciaInicio DateTime @map("vigencia_inicio") @db.Date

  efetivadaEm    DateTime? @map("efetivada_em")
  executorUserId String?   @map("executor_user_id")

  /// Aponta para a movimentacao que esta corrigindo (spec §4.10). A original
  /// transita para `retificada` e permanece na linha do tempo.
  retificaId String? @map("retifica_id")

  destinoUnidadeOrganizacionalId String? @map("destino_unidade_organizacional_id")
  destinoDepartamentoId          String? @map("destino_departamento_id")
  destinoAreaId                  String? @map("destino_area_id")
  destinoEquipeId                String? @map("destino_equipe_id")
  destinoCargoId                 String? @map("destino_cargo_id")
  destinoCentroCustoId           String? @map("destino_centro_custo_id")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vinculo     VinculoFuncional @relation(fields: [vinculoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  solicitante AccessUser       @relation("MovimentacaoSolicitante", fields: [solicitanteUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  executor    AccessUser?      @relation("MovimentacaoExecutor", fields: [executorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  retifica      MovimentacaoFuncional?  @relation("Retificacao", fields: [retificaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  retificadaPor MovimentacaoFuncional[] @relation("Retificacao")

  destinoUnidadeOrganizacional UnidadeOrganizacional? @relation(fields: [destinoUnidadeOrganizacionalId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  destinoDepartamento          Departamento?          @relation(fields: [destinoDepartamentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  destinoArea                  Area?                  @relation(fields: [destinoAreaId, destinoDepartamentoId], references: [id, departamentoId], onDelete: Restrict, onUpdate: Cascade)
  destinoEquipe                Equipe?                @relation(fields: [destinoEquipeId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  destinoCargo                 Cargo?                 @relation(fields: [destinoCargoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  destinoCentroCusto           CentroCusto?           @relation(fields: [destinoCentroCustoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)

  alocacoesOrigem AlocacaoOrganizacional[]

  /// Uma movimentacao efetivada so pode ser retificada UMA vez — a correcao da
  /// correcao e uma nova retificacao encadeada, nunca duas concorrentes sobre
  /// o mesmo original.
  @@unique([retificaId])
  @@index([vinculoId, vigenciaInicio])
  @@index([empresaId, status])
  @@index([solicitanteUserId])
  @@index([executorUserId])
  @@map("movimentacao_funcional")
}

// ---------------------------------------------------------------------------
// Etapa 3 — Jornada e Ponto Rastreavel V1 (ADR 0008, Baseline Jornada V1).
// ---------------------------------------------------------------------------
// ESCOPO FECHADO. O que NAO existe aqui, por decisao registrada, e tao
// importante quanto o que existe:
//
//   - sem escala/jornada complexa (decisao 1) — nenhuma tabela de turno,
//     revezamento ou padrao de horario esperado;
//   - sem origem automatizada (decisao 3) — nenhuma coluna de dispositivo,
//     IP, foto, biometria, geolocalizacao ou proveniencia de arquivo. O unico
//     registro possivel e manual, feito por RH/DP dentro do sistema;
//   - sem periodo_apuracao / fechamento (decisoes 6 e 7) — competencia e um
//     campo do proprio evento, nao uma entidade com estado. Nao ha nada que
//     "feche";
//   - sem workflow de aprovacao (decisao 7) — nenhum campo de aprovador,
//     nenhum status pendente/aprovado;
//   - sem calculo (decisao 6) — nenhuma coluna de saldo, horas, extra ou
//     adicional. O modulo registra ocorrencias; nao as interpreta.
//
// DADO PESSOAL: o par (vinculo, momento) ja e dado pessoal de comportamento e
// presenca. Nenhum nome, matricula ou identificador de pessoa e duplicado
// aqui — o alcance ate a pessoa e sempre via VinculoFuncional.

/// Catalogo FECHADO de tipos de evento (Baseline Jornada V1, decisao 2).
/// Exatamente quatro; qualquer tipo adicional exige decisao de produto propria.
enum TipoEventoPonto {
  entrada
  saida
  inicio_pausa
  fim_pausa
}

/// Motivo CODIFICADO do ajuste — nunca texto livre (decisao 4). Mesmo
/// mecanismo de `MotivoMovimentacao` (Fatia 2) e pela mesma razao: um campo de
/// observacao sem classificacao e por onde dado sensivel entra sem controle.
///
/// O CONTEUDO deste catalogo e detalhe de implementacao, extensivel de forma
/// aditiva e a validar com RH — o que a Baseline fecha e o mecanismo (codigo
/// fechado), nao a lista.
enum MotivoAjustePonto {
  erro_de_digitacao
  registro_duplicado
  registro_indevido
  outro_controlado
}

/// A OCORRENCIA: registro atomico de uma marcacao de ponto.
///
/// IMUTAVEL — e isso e garantido pelo BANCO, nao pela disciplina do service:
/// a migration REVOGA `UPDATE` e `DELETE` de `evolli_app` nesta tabela, mesmo
/// tratamento que `audit_event` recebe desde a ADR 0004. Um exploit na API nao
/// consegue reescrever nem apagar historico de presenca.
///
/// Por isso NAO existe `atualizado_em` aqui: a ausencia da coluna e
/// intencional e sinaliza que a linha nunca muda. Correcao vive em
/// `ajuste_ponto`, apontando para este registro, que permanece legivel.
model EventoPonto {
  id        String          @id @default(uuid())
  vinculoId String          @map("vinculo_id")
  empresaId String          @map("empresa_id")
  tipo      TipoEventoPonto

  /// Instante da marcacao, informado por quem registra (nao e o horario do
  /// servidor: o registro e manual e frequentemente retroativo).
  momento DateTime @db.Timestamptz(3)

  /// Competencia mensal 'YYYY-MM' (decisao 6), calculada NO INSERT a partir de
  /// `momento` sob um unico fuso declarado em codigo, e nunca recalculada.
  ///
  /// Gravar — em vez de derivar na consulta — e deliberado: num modulo cuja
  /// razao de ser e rastreabilidade, o mes a que o registro pertence precisa
  /// ser parte do registro imutavel. Se fosse derivada, mudar o fuso da
  /// aplicacao re-classificaria historico ja gravado, sem nenhuma escrita e
  /// sem deixar rastro.
  competencia String @db.Char(7)

  /// Ator que registrou — `AccessUser`, nunca o colaborador registrado.
  registradoPorUserId String   @map("registrado_por_user_id")
  registradoEm        DateTime @default(now()) @map("registrado_em")

  vinculo       VinculoFuncional @relation(fields: [vinculoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registradoPor AccessUser       @relation("PontoRegistradoPor", fields: [registradoPorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  ajustes AjustePonto[]

  /// Alvo da FK composta de `ajuste_ponto`: o banco garante que ajuste e
  /// evento pertencem a MESMA empresa, sem depender da aplicacao.
  @@unique([id, empresaId])
  @@index([vinculoId, momento])
  @@index([empresaId, competencia])
  @@index([registradoPorUserId])
  @@map("evento_ponto")
}

/// A CORRECAO: registro posterior que corrige ou anula um `EventoPonto`.
///
/// Nunca sobrescreve o original (decisao 4). Tambem e append-only no banco —
/// corrigir um ajuste errado e registrar OUTRO ajuste, encadeado. O valor
/// efetivo de um evento e o do ajuste mais recente; sem ajuste, e o original.
///
/// Cadeia permitida de proposito: um ajuste tambem pode estar errado, e a
/// alternativa (permitir editar o ajuste) reintroduziria exatamente a
/// sobrescrita que a decisao 4 proibe.
model AjustePonto {
  id            String @id @default(uuid())
  eventoPontoId String @map("evento_ponto_id")
  empresaId     String @map("empresa_id")

  motivoCodigo MotivoAjustePonto @map("motivo_codigo")

  /// `true` = o evento nao deveria existir (duplicado, indevido). Nesse caso
  /// nenhum valor corrigido acompanha — anular e corrigir sao efeitos
  /// mutuamente exclusivos, garantido por CHECK na migration.
  anula Boolean @default(false)

  /// Valores corrigidos. `NULL` = este campo nao muda. Um ajuste que nao anula
  /// precisa corrigir ao menos um dos dois (CHECK) — um ajuste sem efeito
  /// nenhum seria ruido na trilha.
  momentoCorrigido DateTime?        @map("momento_corrigido") @db.Timestamptz(3)
  tipoCorrigido    TipoEventoPonto? @map("tipo_corrigido")

  registradoPorUserId String   @map("registrado_por_user_id")
  registradoEm        DateTime @default(now()) @map("registrado_em")

  evento        EventoPonto @relation(fields: [eventoPontoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registradoPor AccessUser  @relation("AjustePontoRegistradoPor", fields: [registradoPorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([eventoPontoId, registradoEm])
  @@index([empresaId])
  @@index([registradoPorUserId])
  @@map("ajuste_ponto")
}

// ===========================================================================
// Etapa 2 — Documentos e Admissao Digital: V1 de METADADOS (ADR 0011, T008).
//
// NADA nestas entidades armazena, referencia ou aponta para CONTEUDO de
// arquivo. Nao existe — em nenhuma delas — coluna de bytes, base64, stream,
// caminho, URL, bucket, chave, hash de conteudo, tamanho, MIME ou nome de
// arquivo original. Upload permanece desabilitado por construcao: nao ha
// entidade de versao de conteudo nem transicao de estado que leve a conteudo
// (ADR 0011, decisoes 1 e 2). Habilitar upload e trabalho de Nivel 2, exige
// nova migration/codigo/ADR — nao ha feature flag.
// ===========================================================================

/// Classificacao de sensibilidade do tipo documental (ADR 0011, decisao 10).
/// Comeca com o UNICO valor aprovado: `restrito`. Todo tipo nasce restrito
/// (Emenda 1 da ADR 0011). Ampliar o esquema de classificacao e DP-2E-02
/// (produto + DPO), por migration aditiva — enum de valor morto seria mais
/// caro remover depois do que acrescentar na hora certa.
enum ClassificacaoDocumento {
  restrito
}

/// Estado de ciclo de vida do metadado. `upload_desabilitado` e o unico estado
/// "ativo" alcancavel e NAO tem transicao de saida para conteudo (ADR 0011,
/// decisao 2) — nao existe estado `disponivel`/`em_processamento` porque nao
/// existe conteudo. `substituido` marca o metadado corrigido por outro mais
/// novo (substituicao preserva historico; nunca exclusao fisica).
enum EstadoDocumento {
  upload_desabilitado
  substituido
}

/// Estado da solicitacao. Nesta V1 so `pendente` e alcancavel: `atendida`
/// exigiria conteudo (Nivel 2) e por isso NAO existe aqui — um valor de enum
/// que nunca poderia ser atingido seria estrutura especulativa.
enum EstadoSolicitacao {
  pendente
}

/// Catalogo de tipos documentais, POR EMPRESA (a fronteira e sempre
/// `empresa_id`; ADR 0011, decisao 5 — sem catalogo global). Apenas RH cria ou
/// altera, com aprovacao de DPO registrada (Emenda 1 da ADR 0011). NAO nomeia
/// nenhum tipo real: as linhas sao dados operacionais criados em runtime, nunca
/// seed — nomear tipos e decisao de produto+DPO (DP-2E-02), nao de schema.
model TipoDocumento {
  id            String                 @id @default(uuid())
  empresaId     String                 @map("empresa_id")
  codigo        String
  nome          String
  classificacao ClassificacaoDocumento @default(restrito)

  /// Evidencia da aprovacao de DPO exigida para operar o catalogo (Emenda 1).
  /// Referencia tecnica registrada no fluxo; a verificacao de que o DPO de fato
  /// a emitiu depende do provisionamento do papel `dpo` (DP-7), pendente — a V1
  /// exige a PRESENCA da referencia e a registra, nao a valida criptograficamente.
  dpoAprovacaoReferencia String   @map("dpo_aprovacao_referencia")
  dpoAprovadoEm          DateTime @map("dpo_aprovado_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  documentosMetadado DocumentoMetadado[]
  solicitacoes       SolicitacaoDocumento[]

  @@unique([empresaId, codigo])
  /// Alvo das FKs compostas de documento_metadado e solicitacao_documento: o
  /// banco garante que o tipo referenciado pertence a mesma empresa (ADR 0011,
  /// decisao 5), sem depender de validacao de aplicacao.
  @@unique([id, empresaId])
  @@index([empresaId])
  @@map("tipo_documento")
}

/// Metadado do documento — o documento como CONCEITO. Sem conteudo (ver bloco
/// acima). O sujeito e o `Colaborador` (DP-2E-07); `empresa_id` e proprio e
/// explicito (nao derivado do colaborador, que nao o tem). Substituicao cria um
/// registro NOVO apontando para o anterior via `substitui_documento_id`; o
/// anterior transita para `substituido` e permanece (sem exclusao fisica).
///
/// INTEGRIDADE empresa<->colaborador (garantida pelo banco, nao so pela
/// aplicacao): o colaborador referenciado PRECISA ter vinculo na mesma empresa
/// do documento. Como o par (colaborador_id, empresa_id) nao e unico em
/// vinculo_funcional, isso nao e FK composta — e um CONSTRAINT TRIGGER diferido
/// criado na migration (`assert_documento_com_vinculo_na_empresa` e
/// `assert_vinculo_nao_orfana_documentos`), no mesmo padrao das invariantes da
/// Fatia 2. Prisma nao expressa triggers; este comentario e a documentacao.
model DocumentoMetadado {
  id                   String          @id @default(uuid())
  empresaId            String          @map("empresa_id")
  colaboradorId        String          @map("colaborador_id")
  tipoDocumentoId      String          @map("tipo_documento_id")
  estado               EstadoDocumento @default(upload_desabilitado)
  substituiDocumentoId String?         @map("substitui_documento_id")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa     Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  colaborador Colaborador   @relation(fields: [colaboradorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tipo        TipoDocumento @relation(fields: [tipoDocumentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)

  /// Auto-relacao COMPOSTA com `empresa_id`: uma substituicao so pode apontar
  /// para metadado da MESMA empresa (garantido pelo banco).
  substitui      DocumentoMetadado?  @relation("SubstituicaoDocumento", fields: [substituiDocumentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  substituidoPor DocumentoMetadado[] @relation("SubstituicaoDocumento")

  /// Alvo da auto-FK composta de substituicao.
  @@unique([id, empresaId])
  @@index([empresaId, colaboradorId])
  @@index([empresaId, estado])
  @@index([tipoDocumentoId, empresaId])
  @@map("documento_metadado")
}

/// Solicitacao (pedido) de um documento. Existe ANTES de qualquer documento e
/// pode nunca ser atendida (atender exige conteudo, Nivel 2). Sem `prazo`
/// (DP-2E-06, Nivel 2), sem canal de notificacao, sem `documento_id` (o vinculo
/// so faz sentido quando `atendida` for alcancavel — adiciona-lo agora seria
/// coluna especulativa).
///
/// Mesma INTEGRIDADE empresa<->colaborador do `DocumentoMetadado`, garantida
/// pelos mesmos CONSTRAINT TRIGGERS diferidos da migration: o colaborador
/// referenciado precisa ter vinculo na mesma empresa da solicitacao.
model SolicitacaoDocumento {
  id              String            @id @default(uuid())
  empresaId       String            @map("empresa_id")
  colaboradorId   String            @map("colaborador_id")
  tipoDocumentoId String            @map("tipo_documento_id")
  estado          EstadoSolicitacao @default(pendente)

  /// Ator que solicitou — `AccessUser`, nunca o colaborador (sujeito).
  solicitanteUserId String   @map("solicitante_user_id")
  solicitadaEm      DateTime @default(now()) @map("solicitada_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa     Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  colaborador Colaborador   @relation(fields: [colaboradorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tipo        TipoDocumento @relation(fields: [tipoDocumentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Cascade)
  solicitante AccessUser    @relation("SolicitacaoDocumentoSolicitante", fields: [solicitanteUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([empresaId, colaboradorId])
  @@index([tipoDocumentoId, empresaId])
  @@index([solicitanteUserId])
  @@map("solicitacao_documento")
}
