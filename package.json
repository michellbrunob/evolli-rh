{
  "name": "evolli-rh",
  "version": "0.1.0",
  "private": true,
  "description": "Ecossistema corporativo de RH e Departamento Pessoal.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
