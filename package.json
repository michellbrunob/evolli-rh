{
  "name": "evolli-rh",
  "version": "0.1.0",
  "private": true,
  "description": "Ecossistema corporativo de RH e Departamento Pessoal.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "spec:check": "node scripts/check-spec-kit-sync.mjs",
    "demo:up": "node scripts/demo-local.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:scripts",
    "test:scripts": "node --test scripts/demo-local.core.test.mjs scripts/demo-local.buscarHttp.test.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  }
}
